<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.restaurant.view.AdminDashboardController">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <!-- Header / Navigation Bar -->
    <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 15; -fx-background-radius: 8;">
        <Label text="Admin Management Portal" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="10.0">
            <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        </HBox>
    </HBox>

    <!-- Main Admin Navigation Tabs -->
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- Tab 1: Menu Management -->
        <Tab text="Menu Management">
            <VBox spacing="10.0">
                <padding>
                    <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                </padding>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <TextField fx:id="itemNameField" promptText="Dish Name" prefWidth="180"/>
                    <TextField fx:id="itemPriceField" promptText="Price ($)" prefWidth="100"/>
                    <Button text="Add Menu Item" onAction="#handleAddItem" styleClass="button-accent"/>
                    <Button text="Delete Selected Item" onAction="#handleDeleteItem" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                    <Button text="Refresh Menu" onAction="#handleRefreshMenu"/>
                </HBox>

                <TableView fx:id="menuTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="Dish Name" prefWidth="250"/>
                        <TableColumn fx:id="priceColumn" text="Price ($)" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- Tab 2: Customer Orders -->
        <Tab text="Customer Orders">
            <VBox spacing="10.0">
                <padding>
                    <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                </padding>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button text="Refresh Orders" onAction="#handleRefreshOrders" styleClass="button-accent"/>
                </HBox>

                <TableView fx:id="ordersTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="orderIdColumn" text="Order ID" prefWidth="180"/>
                        <TableColumn fx:id="orderTableColumn" text="Table" prefWidth="70"/>
                        <TableColumn fx:id="orderSeatsColumn" text="Seats" prefWidth="70"/>
                        <TableColumn fx:id="orderTimeColumn" text="Date &amp; Time" prefWidth="180"/>
                        <TableColumn fx:id="orderItemsColumn" text="Items" prefWidth="250"/>
                        <TableColumn fx:id="orderTotalColumn" text="Total Amount ($)" prefWidth="150"/>
                        <TableColumn fx:id="orderStatusColumn" text="Status" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

    </TabPane>

    <Label fx:id="statusLabel" styleClass="error-text" visible="false"/>

</VBox>
