<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.restaurant.view.CustomerDashboardController">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <!-- Header / Navigation Bar -->
    <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 15; -fx-background-radius: 8;">
        <Label text="Restaurant Portal" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="10.0">
            <Button text="View Cart / Order" onAction="#handleViewCart" styleClass="button-accent"/>
            <Button text="Book Reservation" onAction="#handleBookReservation"/>
            <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        </HBox>
    </HBox>

    <!-- Title & Search Bar -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label text="Menu Items" styleClass="header-title"/>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="10.0">
            <TextField fx:id="searchField" promptText="Search dishes..." prefWidth="200"/>
            <ComboBox fx:id="categoryFilter" promptText="All Categories" prefWidth="150"/>
        </HBox>
    </HBox>

    <!-- Menu List -->
    <ListView fx:id="menuListView" VBox.vgrow="ALWAYS" prefHeight="350"/>

    <!-- Bottom Status / Action -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Label fx:id="statusLabel" styleClass="error-text" visible="false"/>
        <Button text="Add Selected Item to Cart" onAction="#handleAddToCart"/>
    </HBox>

</VBox>