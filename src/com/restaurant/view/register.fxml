<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.restaurant.view.RegisterController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
    </padding>

    <Label text="Customer Registration" styleClass="header-title"/>
    <Label text="Create your account to make reservations and order food" style="-fx-text-fill: #7f8c8d;"/>

    <VBox spacing="4.0" maxWidth="320">
        <Label text="Full Name:"/>
        <TextField fx:id="nameField" promptText="John Doe"/>
    </VBox>

    <VBox spacing="4.0" maxWidth="320">
        <Label text="Username:"/>
        <TextField fx:id="usernameField" promptText="johndoe"/>
    </VBox>

    <VBox spacing="4.0" maxWidth="320">
        <Label text="Password:"/>
        <PasswordField fx:id="passwordField" promptText="Minimum 6 characters"/>
    </VBox>

    <VBox spacing="4.0" maxWidth="320">
        <Label text="Phone Number:"/>
        <TextField fx:id="phoneField" promptText="01xxxxxxxxx"/>
    </VBox>

    <Label fx:id="statusLabel" styleClass="error-text" visible="false"/>

    <Button text="Register Account" onAction="#handleRegister" prefWidth="320"/>
    <Button text="Back to Login" onAction="#handleBackToLogin" prefWidth="320" styleClass="button-accent"/>

</VBox>