<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.restaurant.view.ReservationViewController">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <!-- Navigation Header -->
    <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 15; -fx-background-radius: 8;">
        <Label text="Table Reservation Portal" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
            <Button text="Back to Dashboard" onAction="#handleBackToDashboard"/>
        </HBox>
    </HBox>

    <!-- Reservation Form -->
    <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-border-color: #e0e0e0; -fx-border-radius: 5;">
        <Label text="Book a New Reservation" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <DatePicker fx:id="reservationDatePicker" promptText="Select Date" prefWidth="180"/>
            <ComboBox fx:id="timeSlotComboBox" promptText="Select Time" prefWidth="150"/>
            <TextField fx:id="partySizeField" promptText="Party Size (e.g. 2, 4)" prefWidth="150"/>
            <Button text="Reserve Selected Table" onAction="#handleCreateReservation" styleClass="button-accent"/>
        </HBox>
    </VBox>

    <!-- Available Tables List -->
    <Label text="Available Tables" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    <ListView fx:id="tablesListView" VBox.vgrow="ALWAYS" prefHeight="220"/>

    <Label fx:id="statusLabel" styleClass="error-text" visible="false"/>

</VBox>