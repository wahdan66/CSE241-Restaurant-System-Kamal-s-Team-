<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.restaurant.view.WaiterDashboardController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 15; -fx-background-radius: 8;">
        <Label text="Waiter Orders" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
            <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        </HBox>
    </HBox>
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <ComboBox fx:id="statusComboBox" promptText="New status" prefWidth="180"/>
        <Button text="Update Selected Order" onAction="#handleUpdateStatus" styleClass="button-accent"/>
    </HBox>
    <TableView fx:id="ordersTableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="orderIdColumn" text="Order ID" prefWidth="230"/>
            <TableColumn fx:id="tableColumn" text="Table" prefWidth="70"/>
            <TableColumn fx:id="seatsColumn" text="Seats" prefWidth="70"/>
            <TableColumn fx:id="timeColumn" text="Date &amp; Time" prefWidth="180"/>
            <TableColumn fx:id="itemsColumn" text="Items" prefWidth="240"/>
            <TableColumn fx:id="totalColumn" text="Total ($)" prefWidth="150"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="160"/>
        </columns>
    </TableView>
    <Label fx:id="statusLabel" styleClass="error-text" visible="false"/>
</VBox>
